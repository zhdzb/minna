# Server-side LLM provider selection
DEFAULT_LLM_PROVIDER=gemini

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI-compatible provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_BASE_URL=https://llmapi.devart.ai
OPENAI_REASONING_EFFORT=xhigh

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m2.7
OPENROUTER_BASE_URL=https://openrouter.ai/api

# Persistence mode
APP_PERSISTENCE_MODE=local

# Cloud persistence placeholders
CLOUD_STORAGE_PROVIDER=
CLOUD_STORAGE_URL=
CLOUD_STORAGE_TOKEN=
