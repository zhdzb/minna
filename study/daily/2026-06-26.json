    {
      "id": "material-lesson-7-grammar",
      "type": "grammar_note",
      "lesson": 7,
      "title": "Means particle review",
      "content": "Use で for tools and means, and contrast あげます with もらいます when ownership direction changes.",
      "examples": [
        {
          "ja": "バスで 行きます。",
          "zh": "坐公交去。",
          "note": "で marks the means of transport."
        },
        {
          "ja": "わたしは 友だちに 本を あげました。",
          "zh": "我给了朋友一本书。",
          "note": "あげました marks giving away from the speaker."
        }
      ]
    },
    {
      "id": "material-lesson-7-listening",
      "type": "listening_script",
      "lesson": 7,
      "title": "Listening script",
      "content": "A: どうやって 行きますか。 B: バスで 行きます。 A: だれに 本を もらいましたか。 B: 先生に もらいました。",
      "examples": [
        {
          "ja": "どうやって 行きますか。",
          "zh": "怎么去？",
          "note": "Sets up a means-of-transport answer."
        },
        {
          "ja": "先生に もらいました。",
          "zh": "从老师那里收到了。",
          "note": "に marks the giver with もらいました."
        }
      ]
    }
  ],
