  "study_materials": [
    {
      "id": "material-lesson-7-grammar",
      "type": "grammar_note",
      "lesson": 7,
      "title": "交通方式与授受动词复习",
      "content": "使用「で」表示交通工具或手段；在授受关系里，用「あげます」表示给出去，用「もらいます」表示从别人那里得到。",
      "examples": [
        {
          "ja": "バスで 行きます。",
          "zh": "坐公交车去。",
          "note": "「で」标记交通方式。"
        },
        {
          "ja": "わたしは 先生に 本を あげました。",
          "zh": "我给了老师一本书。",
          "note": "「あげました」表示从说话人这边给出去。"
        }
      ]
    },
    {
      "id": "material-lesson-7-listening",
      "type": "listening_script",
      "lesson": 7,
      "title": "第 7 课听力脚本",
      "content": "A: どうやって 行きますか。 B: バスで 行きます。 A: だれに 本を もらいましたか。 B: 先生に もらいました。",
      "examples": [
        {
          "ja": "どうやって 行きますか。",
          "zh": "怎么去？",
          "note": "引出交通方式回答。"
        },
        {
          "ja": "先生に もらいました。",
          "zh": "从老师那里收到的。",
          "note": "「に」标记授予者。"
        }
      ]
    }
  ],
